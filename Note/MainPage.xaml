<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Note.MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Label Style="{StaticResource Headline}"
               Text="Notatki"/>

        <CollectionView Grid.Row="1"
                        x:Name="cviewNotes">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SubHeadline}"
                           Text="{Binding Title}"/>
                        <Label Text="{Binding Content}"/>
                        <Border/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Style="{StaticResource Headline}"
               Text="Dodanie notatki"
               Grid.Row="2"/>

        <VerticalStackLayout Grid.Row="3">
            <Label Text="Tytuł notatki"/>
            <Entry x:Name="entTitle"/>
            <Label Text="Treść notatki"/>
            <Entry x:Name="entContent"/>
        </VerticalStackLayout>

        <Button Grid.Row="4"
                Text="Dodaj notatkę"
                Clicked="AddNote"/>

    </Grid>

</ContentPage>
